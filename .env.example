# Copy to .env. Generate different credentials for every environment.
DATABASE_URL=postgresql://ceti:local-development-only@127.0.0.1:5432/ceti?schema=public
APP_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=CETI <nao-responda@localhost>
# SMTP_USER and SMTP_PASSWORD are required together for authenticated SMTP.
SMTP_USER=
SMTP_PASSWORD=
# Required: 32 random bytes encoded in hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
MFA_ENCRYPTION_KEY=
# Only enable behind a reverse proxy which OVERWRITES x-forwarded-for.
TRUST_PROXY=false
# Dedicated disposable database only, never the production database.
TEST_DATABASE_URL=postgresql://ceti:local-development-only@127.0.0.1:5432/ceti_test?schema=public
